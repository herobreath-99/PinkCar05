{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinkcare-digital-compass",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
